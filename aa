 $work = Join-Path $env:TEMP ("qt_rest_api-" + [guid]::NewGuid())

  New-Item -ItemType Directory -Path $work | Out-Null
  Push-Location $work

  git init
  git symbolic-ref HEAD refs/heads/develop
  git -c user.name="SU2 initializer" `
      -c user.email="su2@elara.local" `
      commit --allow-empty -m "Initial commit"

  git remote add origin "http://bitbucket.inc.elara.local/scm/su2/qt_rest_api.git"
  git push origin HEAD:refs/heads/develop HEAD:refs/heads/master

  Pop-Location
