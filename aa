(async () => {
    const project = "SU2";
    const repo = "qt_rest_api";
    const url = `/rest/api/1.0/projects/${project}/repos`;

    const existing = await fetch(`${url}/${repo}`, {
      credentials: "same-origin"
    });

    if (existing.ok) {
      console.log(`Репозиторий ${project}/${repo} уже существует`);
      return;
    }

    if (existing.status !== 404) {
      throw new Error(`${existing.status}: ${await existing.text()}`);
    }

    const response = await fetch(url, {
      method: "POST",
      credentials: "same-origin",
      headers: {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "X-Atlassian-Token": "no-check"
      },
      body: JSON.stringify({
        name: repo,
        scmId: "git",
        forkable: true
      })
    });

    const body = await response.text();

    if (!response.ok) {
      throw new Error(`${response.status}: ${body}`);
    }

    console.log(`Создан ${project}/${repo}`, response.status);
  })();
