(async () => {
    const project = "SU2";
    const repos = [
      "as_system_data",
      "el_conf_chart_data_manager",
      "el_conf_config_builder",
      "el_conf_device_config_manager",
      "el_conf_core_sdk",
      "el_conf_gui_sdk",
      "el_conf_themes",
      "el_conf_utils",
      "el_conf_elecont_protocol_client",
      "el_conf_plugin_sdk",
      "el_conf_sura_connector_client",
      "el_conf_chart_ui_plugin",
      "as_app"
    ];

    async function api(url, options = {}) {
      const response = await fetch(url, {
        credentials: "same-origin",
        ...options,
        headers: {
          Accept: "application/json",
          "X-Atlassian-Token": "no-check",
          ...(options.body ? { "Content-Type": "application/json" } : {}),
          ...(options.headers || {})
        }
      });

      const text = await response.text();
      let data = text;

      try {
        data = text ? JSON.parse(text) : null;
      } catch (ignored) {}

      if (!response.ok) {
        throw new Error(
          `${options.method || "GET"} ${url}: HTTP ${response.status}: ${text}`
        );
      }

      return data;
    }

    if (!confirm("Создать master во всех 13 репозиториях?")) {
      return;
    }

    for (const repo of repos) {
      const repoBase =
        `/rest/api/1.0/projects/${project}/repos/${repo}`;

      const branches = await api(
        `${repoBase}/branches?filterText=master&limit=100`
      );

      if (branches.values.some(b => b.id === "refs/heads/master")) {
        console.log("ALREADY EXISTS", repo);
        continue;
      }

      const hooks = await api(
        `${repoBase}/settings/hooks?type=PRE_RECEIVE&limit=100`
      );

      const controlFreakHooks = hooks.values.filter(hook => {
        const details = hook.details || {};
        const description = [
          details.key,
          details.name,
          details.description
        ].join(" ").toLowerCase();

        return hook.enabled && (
          description.includes("control freak") ||
          description.includes("control-freak") ||
          description.includes("controlfreak")
        );
      });

      if (controlFreakHooks.length !== 1) {
        throw new Error(
          `${repo}: найдено активных Control Freak hooks: ` +
          controlFreakHooks.length
        );
      }

      const hook = controlFreakHooks[0];
      const hookKey = encodeURIComponent(hook.details.key);
      const hookBase = `${repoBase}/settings/hooks/${hookKey}`;
      const originalScope = hook.scope && hook.scope.type;
      let originalSettings = null;
      let disabled = false;

      if (originalScope === "REPOSITORY") {
        originalSettings = await api(`${hookBase}/settings`);
      }

      try {
        await api(`${hookBase}/enabled`, { method: "DELETE" });
        disabled = true;
        console.log("HOOK DISABLED", repo);

        await api(
          `/rest/branch-utils/1.0/projects/${project}/repos/${repo}/branches`,
          {
            method: "POST",
            body: JSON.stringify({
              name: "master",
              startPoint: "refs/heads/develop"
            })
          }
        );

        console.log("MASTER CREATED", repo);
      } finally {
        if (disabled) {
          try {
            if (originalScope === "REPOSITORY") {
              await api(`${hookBase}/enabled`, {
                method: "PUT",
                body: JSON.stringify(originalSettings)
              });
            } else {
              await api(hookBase, { method: "DELETE" });
            }

            console.log("HOOK RESTORED", repo);
          } catch (error) {
            console.error("CRITICAL: HOOK NOT RESTORED", repo, error);
            alert(`Не удалось восстановить Control Freak для ${repo}`);
            throw error;
          }
        }
      }
    }

    console.log("FINISHED: master создан во всех репозиториях");
  })();
