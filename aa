(async () => {
    const repos = [
      "as_system_data",
      "el_conf_chart_data_manager",
      "el_conf_config_builder",
      "el_conf_device_config_manager",
      "el_conf_core_sdk",
      "el_conf_gui_sdk",
      "el_conf_themes",
      "el_conf_utils",
      "el_conf_elecont_protocol_client",
      "el_conf_plugin_sdk",
      "el_conf_sura_connector_client",
      "el_conf_chart_ui_plugin",
      "as_app"
    ];

    for (const repo of repos) {
      const list = await fetch(
        `/rest/api/1.0/projects/SU2/repos/${repo}/branches?filterText=master&limit=100`,
        { credentials: "same-origin" }
      );

      if (!list.ok) {
        console.error("CHECK ERROR", repo, list.status);
        continue;
      }

      const branches = await list.json();

      if (branches.values.some(b => b.id === "refs/heads/master")) {
        console.log("ALREADY EXISTS", repo);
        continue;
      }

      const response = await fetch(
        `/rest/branch-utils/1.0/projects/SU2/repos/${repo}/branches`,
        {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
            "X-Atlassian-Token": "no-check"
          },
          body: JSON.stringify({
            name: "master",
            startPoint: "refs/heads/develop"
          })
        }
      );

      console.log(
        response.ok ? "CREATED" : "ERROR",
        repo,
        response.status,
        await response.text()
      );
    }
  })();
