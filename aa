
1. Создай пустой as_doc в браузере

В Bitbucket открой СУРА2 → Create repository:
- имя: as_doc;
- без README и других начальных файлов.

Если as_doc уже есть, новый создавать не нужно.

2. Склонируй текущие исходники cs_doc

cd /d "%USERPROFILE%\Downloads"
git clone https://bitbucket.inc.elara.local/scm/su2/cs_doc.git as_doc_work
cd as_doc_work

Если каталог as_doc_work уже существует, используй другое новое имя. Не удаляй существующий каталог.

3. Подключи назначение и проверь, что оно пустое

git remote rename origin source
git remote add origin https://bitbucket.inc.elara.local/scm/su2/as_doc.git
git ls-remote --refs orig

Последняя команда должна го не вывести. Если вывелассылки на ветки или теги, остановись: as_doc уже непустой.

4. Создай начальный коммит без истории cs_doc

git var GIT_AUTHOR_IDENT

Если git сообщает, что автор не настроен, задай свои данные только для этой локальной копии:

git config user.name "Тво
git config user.email "Твой рабочий email"

Затем:

git checkout --orphan as-doc-initial
git commit -m "Initial so

Файлы уже находятся в индan. git add здесь не нужен.

5. Отправь исходники в дв
                                                                             git push --atomic origin masteras-doc-initial:refs/heads/develop                                            
Получатся master и develop с одним начальным коммитом. Старая история cs_doc не отправится. Сам cs_doc

В настройках as_doc выбер.


sudo docker compose logs server 2>&1 | grep "Super user authentication token" | tail -1

(async () => {
    const API = "/app/rest/2018.1";
    const SOURCE_PATH = ["SURA2", "COMPONENTS", "CMAKE", "EL_CONF"];
    const TARGET_NAME = "QT_REST_API";

    const PARAMETERS = {
      repoProject: "su2",
      repoName: "qt_rest_api",
      projectName: "qt_rest_api"
    };

    let csrfToken = "";

    try {
      const csrfResponse = await fetch(
        "/authenticationTest.html?csrf",
        { credentials: "same-origin" }
      );

      if (csrfResponse.ok) {
        csrfToken = (await csrfResponse.text()).trim();
      }
    } catch (_) {}

    async function request(path, options = {}) {
      const method = options.method || "GET";
      const headers = {
        Accept: "application/json",
        ...(options.headers || {})
      };

      if (csrfToken && method !== "GET" && method !== "HEAD") {
        headers["X-TC-CSRF-Token"] = csrfToken;
      }

      const response = await fetch(API + path, {
        method,
        headers,
        body: options.body,
        credentials: "same-origin"
      });

      const text = await response.text();

      if (!response.ok) {
        throw new Error(
          `${method} ${path}\nHTTP ${response.status}\n${text}`
        );
      }

      return text;
    }

    const query = new URLSearchParams({
      locator: "count:10000",
      fields: "project(id,name,parentProjectId)"
    });

    const response = JSON.parse(
      await request(`/projects?${query.toString()}`)
    );

    const projects = response.project || [];
    const projectsById = new Map(
      projects.map(project => [project.id, project])
    );

    function projectPath(project) {
      const result = [];
      const visited = new Set();
      let current = project;

      while (current && !visited.has(current.id)) {
        visited.add(current.id);
        result.unshift(current.name);
        current = projectsById.get(current.parentProjectId);
      }

      return result;
    }

    function normalize(value) {
      return String(value || "")
        .toUpperCase()
        .replace(/[^A-Z0-9А-ЯЁ]+/g, "");
    }

    const expectedPath = SOURCE_PATH.map(normalize).join("/");

    const sourceProjects = projects.filter(project => {
      const path = projectPath(project)
        .slice(-SOURCE_PATH.length)
        .map(normalize)
        .join("/");

      return path === expectedPath;
    });

    if (sourceProjects.length !== 1) {
      throw new Error(
        `Не найден единственный проект ${SOURCE_PATH.join(" / ")}. ` +
        `Найдено: ${sourceProjects.length}`
      );
    }

    const source = sourceProjects[0];
    const parentId = source.parentProjectId;

    let target = projects.find(project =>
      project.parentProjectId === parentId &&
      normalize(project.name) === normalize(TARGET_NAME)
    );

    let targetId;

    if (!target) {
      targetId = `${parentId}_QtRestApi`
        .replace(/[^A-Za-z0-9_]/g, "_");

      const payload = {
        id: targetId,
        name: TARGET_NAME,
        copyAllAssociatedSettings: true,
        sourceProject: {
          locator: `id:${source.id}`
        },
        parentProject: {
          locator: `id:${parentId}`
        }
      };

      const created = JSON.parse(
        await request("/projects", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        })
      );

      targetId = created.id || targetId;
      console.log(`Проект ${TARGET_NAME} создан из EL_CONF`);
    } else {
      targetId = target.id;
      console.log(`Проект ${TARGET_NAME} уже существует`);

      if (target.name !== TARGET_NAME) {
        await request(
          `/projects/${encodeURIComponent(`id:${targetId}`)}/name`,
          {
            method: "PUT",
            headers: {
              "Content-Type": "text/plain"
            },
            body: TARGET_NAME
          }
        );
      }
    }

    const targetLocator = encodeURIComponent(`id:${targetId}`);

    for (const [name, value] of Object.entries(PARAMETERS)) {
      await request(
        `/projects/${targetLocator}/parameters/${encodeURIComponent(name)}`,
        {
          method: "PUT",
          headers: {
            "Content-Type": "text/plain"
          },
          body: value
        }
      );

      console.log(`${name}=${value}`);
    }

    console.log(
      `ГОТОВО: ${location.origin}/project.html?projectId=${encodeURIComponent(targetId)}`
    );
  })().catch(error => console.error("ОШИБКА:", error));

