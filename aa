        { credentials: "same-origin" }
      );

      if (!check.ok) {
        console.error("CHECK ERROR", repo, check.status);
        failed++;
        continue;
      }

      const branches = await check.json();

      if (branches.values.some(b => b.id === "refs/heads/master")) {
        console.log("ALREADY EXISTS", repo);
        existed++;
        continue;
      }

      const response = await fetch(
        `/rest/branch-utils/1.0/projects/SU2/repos/${repo}/branches`,
        {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
            "X-Atlassian-Token": "no-check"
          },
          body: JSON.stringify({
            name: "master",
            startPoint: "refs/heads/develop"
          })
        }
      );

      const responseText = await response.text();

      if (response.ok) {
        console.log("MASTER CREATED", repo);
        created++;
      } else {
        console.error("CREATE ERROR", repo, response.status, responseText);
        failed++;
      }
    }

    console.log(
      `FINISHED: created=${created}, existed=${existed}, failed=${failed}`
    );
