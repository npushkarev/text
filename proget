cat > /etc/zabbix/scripts/proget_health.sh <<'EOF'                                                                                
     #!/bin/sh                                                                                                                         
     # proget_health.sh <поле|raw|rtt> — ProGet 26: /health = plain text "OK"                                                          
     url="http://127.0.0.1:8624/health"                                                                                                
     db="proget-database"                                                                                                              
                                                                                                                                       
     alive() {                                                                                                                         
         [ "$(curl -s --noproxy '*' -m 8 "$url" 2>/dev/null)" = "OK" ]                                                                 
     }                                                                                                                                 
                                                                                                                                       
     case "${1:-raw}" in                                                                                                               
         rtt)                                                                                                                          
             curl -s -o /dev/null --noproxy '*' -m 8 -w '%{time_total}' "$url" 2>/dev/null || echo 0                                   
             ;;                                                                                                                        
         raw)                                                                                                                          
             curl -s --noproxy '*' -m 8 "$url" 2>/dev/null || echo ''                                                                  
             ;;                                                                                                                        
         serviceStatus|licenseStatus)                                                                                                  
             alive && echo OK || echo UNKNOWN                                                                                          
             ;;                                                                                                                        
         versionNumber)                                                                                                                
             curl -s -D - -o /dev/null --noproxy '*' -m 8 "$url" 2>/dev/null \                                                         
                 | tr -d '\r' | sed -n 's/^X-ProGet-Version:[[:space:]]*//Ip' | head -1                                                
             ;;                                                                                                                        
         databaseStatus)                                                                                                               
             h=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$db" 2>/dev/null) || h=missing   
             [ "$h" = "healthy" ] && echo OK || echo "${h:-missing}"                                                                   
             ;;                                                                                                                        
         *)                                                                                                                            
             echo UNKNOWN                                                                                                              
             ;;                                                                                                                        
     esac                                                                                                                              
     EOF                                                                                                                               
     chmod 0755 /etc/zabbix/scripts/proget_health.sh 
